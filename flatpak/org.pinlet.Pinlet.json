{
  "app-id": "org.pinlet.Pinlet",
  "runtime": "org.gnome.Platform",
  "runtime-version": "48",
  "sdk": "org.gnome.Sdk",
  "sdk-extensions": ["org.freedesktop.Sdk.Extension.rust-stable"],
  "command": "pinlet",
  "finish-args": [
    "--socket=wayland",
    "--socket=fallback-x11",
    "--talk-name=org.freedesktop.Notifications",
    "--talk-name=org.kde.StatusNotifierWatcher",
    "--talk-name=org.freedesktop.portal.GlobalShortcuts",
    "--filesystem=~/.local/share/pinlet",
    "--filesystem=xdg-config/autostart:create"
  ],
  "modules": [
    {
      "name": "pinlet",
      "buildsystem": "simple",
      "build-options": {
        "append-path": "/usr/lib/sdk/rust-stable/bin",
        "env": {
          "CARGO_HOME": "/run/build/pinlet/cargo"
        }
      },
      "build-commands": [
        "cargo --offline fetch",
        "cargo --offline build --release",
        "install -Dm755 target/release/pinlet /app/bin/pinlet",
        "install -Dm644 assets/org.pinlet.Pinlet.desktop /app/share/applications/org.pinlet.Pinlet.desktop",
        "install -Dm644 assets/org.pinlet.Pinlet.svg /app/share/icons/hicolor/scalable/apps/org.pinlet.Pinlet.svg",
        "install -Dm644 assets/org.pinlet.Pinlet.metainfo.xml /app/share/metainfo/org.pinlet.Pinlet.metainfo.xml"
      ],
      "sources": [
        "cargo-sources.json",
        {
          "type": "dir",
          "path": ".."
        }
      ]
    }
  ]
}
