# Maintainer: Daniel Kimani <dankim761@gmail.com>

pkgname=pinlet-git
pkgver=0.1.0.r0.g186d18c
pkgrel=1
pkgdesc="Native sticky notes for the Linux desktop"
arch=('x86_64')
url="https://github.com/dan-kimani/pinlet"
license=('MIT')
depends=('gtk4' 'libadwaita' 'git')
makedepends=('cargo')
source=("$pkgname::git+$url.git")
sha256sums=('SKIP')

pkgver() {
  cd "$srcdir/$pkgname"
  git describe --long --tags 2>/dev/null \
    | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g' \
    || printf "0.1.0.r%s.g%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
  cd "$srcdir/$pkgname"
  cargo build --release --locked
}

package() {
  cd "$srcdir/$pkgname"
  install -Dm755 target/release/pinlet "$pkgdir/usr/bin/pinlet"
  install -Dm644 assets/org.pinlet.Pinlet.desktop \
    "$pkgdir/usr/share/applications/org.pinlet.Pinlet.desktop"
  install -Dm644 assets/org.pinlet.Pinlet.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/org.pinlet.Pinlet.svg"
  install -Dm644 assets/org.pinlet.Pinlet.metainfo.xml \
    "$pkgdir/usr/share/metainfo/org.pinlet.Pinlet.metainfo.xml"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
